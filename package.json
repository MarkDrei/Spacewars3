{
  "name": "spacewars-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:local": "docker compose up --wait db && vitest run",
    "ci": "npm run lint && npm run typecheck && npm run test:ci && npm run build",
    "ci:local": "npm run lint && npm run typecheck && npm run test:local && npm run build",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:bc": "vitest run --reporter=tap | perl -pe \"s/ - ([^#]*) #/ - \\e[33m\\$1\\e[0m #/g\" | grep --line-buffered \"not ok\"",
    "export-db": "npx tsx scripts/export-database-to-html.ts",
    "npc-cleanup": "tsx scripts/cleanup-npc-users.ts",
    "techtree-chart": "tsx scripts/generate-techtree-chart.ts",
    "balancing-charts": "tsx scripts/generate-balancing-charts.ts",
    "screenshots": "tsx scripts/screenshots/generate-screenshots.ts",
    "typecheck": "tsc --noEmit"
  },
  "_comments": {
    "test": "Runs tests (devcontainer: uses db service via POSTGRES_TEST_* env vars set in docker-compose.yml)",
    "test:ci": "Runs tests in CI/CD environment (GitHub Actions with services, uses POSTGRES_TEST_* env vars)",
    "test:local": "Runs tests locally outside devcontainer (starts db Docker service, connects on localhost:5432)"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@markdrei/ironguard-typescript-locks": "0.2.3",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bcrypt": "^6.0.0",
    "iron-session": "^9.0.1",
    "next": "^16.4.5",
    "next-intl": "^4.9.1",
    "nodemailer": "^10.4.0",
    "pg": "^8.13.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "^31.0.0",
    "tsx": "^4.21.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.22": true,
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=24"
  }
}
